{
	"version": 5,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 23,
		"patch": 0
	},
	"configurePresets":[
		{
			"name": "ch32v003",
			"displayName": "CH32V003 with GCC from MounRiver Studio",
			"description": "Using RISC-V GCC compiler for CH32V003 Family of MCU.",
			"hidden": false,
			"toolchainFile": "cmake/toolchain-riscv-none-elf-gcc.cmake",
			"inherits": "ch32v003-base",
			"binaryDir": "${sourceDir}/build/ch32v003",
			"cacheVariables": {
				"toolchain_path": "$env{USERPROFILE}/dev/tools/RISC-V_Embedded_GCC12/bin/"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		}
	]
}
